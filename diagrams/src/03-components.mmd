    REC["Recommendation engine<br/>(rule evaluation + explanation)"]
    REP["Reports and export"]
  end
  DB[("PostgreSQL")]
  RULES[/"Versioned rules and norms<br/>config/recommendation-rules.yaml"/]
  Client -- "REST / JSON (OpenAPI)" --> AUTH
  AUTH --> PT & MET & IMP & REP
