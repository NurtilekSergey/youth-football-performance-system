flowchart TB
  subgraph Client["Web client (React + TypeScript, responsive)"]
    V1["Data entry views"]
    V2["Player / team dashboards"]
    V3["Recommendation view"]
    V4["Admin / rules configuration"]
  end
  subgraph Backend["Backend API (FastAPI) - draft"]
    AUTH["Auth and RBAC"]
